{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus / VictoriaMetrics datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "prometheus", "uid": "VM" },
        "enable": true,
        "expr": "changes(process_start_time_seconds{job=~\"xray-core-metrics|xray-ui-metrics|grafana\", instance=~\"$instance\"}[5m]) > 0",
        "hide": false,
        "iconColor": "rgba(255, 96, 96, 1)",
        "name": "Рестарты сервисов",
        "showIn": 0,
        "textFormat": "{{job}} restart",
        "type": "tags"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Обзор",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Статусы сервисов",
      "description": "Timeline доступности всех компонентов: Xray Core, UI, Checker, Grafana и прокси.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        { "expr": "up{job=\"xray-core-metrics\", instance=~\"$instance\"}", "legendFormat": "Xray Core", "refId": "A" },
        { "expr": "up{job=\"xray-ui-metrics\", instance=~\"$instance\"}", "legendFormat": "Xray UI", "refId": "E" },
        { "expr": "up{job=\"xray-checker\", instance=~\"$instance\"}", "legendFormat": "Xray Checker", "refId": "B" },
        { "expr": "up{job=\"grafana\", instance=~\"$instance\"}", "legendFormat": "Grafana", "refId": "C" },
        { "expr": "min(xray_proxy_status{job=\"xray-checker\", instance=~\"$instance\"}) or on() min(xray_checker_proxy_status{job=\"xray-checker\", instance=~\"$instance\"}) or on() min(probe_success{job=\"xray-checker\", instance=~\"$instance\"})", "legendFormat": "Proxy", "refId": "D" }
      ],
      "options": {
        "rowHeight": 0.9,
        "mergeValues": false,
        "showValue": "never"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Uptime Grafana",
      "description": "Время работы Grafana с последнего запуска.",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        { "expr": "time() - process_start_time_seconds{job=\"grafana\", instance=~\"$instance\"}", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1800 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Uptime Xray",
      "description": "Время работы Xray Core с последнего запуска.",
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        { "expr": "max(xray_uptime_seconds{job=~\"xray-ui-metrics|xray-core-metrics\", instance=~\"$instance\"})", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Онлайн пользователей",
      "description": "Текущее количество активных пользователей прокси.",
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        { "expr": "max(xray_users_online{job=~\"xray-ui-metrics|xray-core-metrics\", instance=~\"$instance\"})", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Трафик",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Скорость трафика (байт/с) — входящий/исходящий",
      "description": "Uplink — от клиентов к серверу (входящий). Downlink — от сервера к клиентам (исходящий).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        { "expr": "rate(xray_traffic_uplink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\"}[5m])", "legendFormat": "Входящий (uplink)", "refId": "A" },
        { "expr": "rate(xray_traffic_downlink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\"}[5m])", "legendFormat": "Исходящий (downlink)", "refId": "B" }
      ],
      "links": [
        {
          "title": "Открыть Explore",
          "url": "/explore?orgId=1&left=%7B%22datasource%22:%22VM%22,%22range%22:%7B%22from%22:%22${__from}%22,%22to%22:%22${__to}%22%7D%7D",
          "targetBlank": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "lineWidth": 2,
          "fillOpacity": 20
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Задержка прокси (мс, xray-checker)",
      "description": "Средняя задержка (латентность) проверки прокси через xray-checker.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        {
          "expr": "avg(xray_proxy_latency_ms{job=\"xray-checker\", instance=~\"$instance\"}) or on() avg(xray_checker_proxy_latency_ms{job=\"xray-checker\", instance=~\"$instance\"}) or on() avg(xray_checker_latency_ms{job=\"xray-checker\", instance=~\"$instance\"}) or on() (avg(probe_duration_seconds{job=\"xray-checker\", instance=~\"$instance\"}) * 1000)",
          "legendFormat": "avg",
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Открыть Explore",
          "url": "/explore?orgId=1&left=%7B%22datasource%22:%22VM%22,%22range%22:%7B%22from%22:%22${__from}%22,%22to%22:%22${__to}%22%7D%7D",
          "targetBlank": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Пользователи",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Активность пользователей (байт/с)",
      "description": "Скорость трафика каждого пользователя (uplink+downlink). Подписи берутся из alias.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        {
          "expr": "sum by (user, alias) ((rate(xray_traffic_user_uplink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\", user=~\"$user\"}[2m]) + rate(xray_traffic_user_downlink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\", user=~\"$user\"}[2m])) * on(user) group_left(alias) xray_user_alias_info{job=\"xray-ui-metrics\", instance=~\"$instance\", user=~\"$user\"}) or label_replace(sum by (user) (rate(xray_traffic_user_uplink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\", user=~\"$user\"}[2m]) + rate(xray_traffic_user_downlink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\", user=~\"$user\"}[2m])) unless on(user) xray_user_alias_info{job=\"xray-ui-metrics\", instance=~\"$instance\", user=~\"$user\"}, \"alias\", \"$1\", \"user\", \"(.*)\")",
          "legendFormat": "{{alias}}",
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Открыть Explore",
          "url": "/explore?orgId=1&left=%7B%22datasource%22:%22VM%22,%22range%22:%7B%22from%22:%22${__from}%22,%22to%22:%22${__to}%22%7D%7D",
          "targetBlank": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Пользователи — email/подпись/трафик",
      "description": "Таблица всех активных пользователей: email, alias, текущая скорость и суммарный трафик за 30 дней.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        {
          "expr": "rate(xray_traffic_user_uplink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\", user=~\"$user\"}[5m])",
          "legendFormat": "{{user}}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "rate(xray_traffic_user_downlink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\", user=~\"$user\"}[5m])",
          "legendFormat": "{{user}}",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "xray_user_alias_info{job=\"xray-ui-metrics\", instance=~\"$instance\", user=~\"$user\"}",
          "legendFormat": "{{user}}",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "(increase(xray_traffic_user_uplink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\", user=~\"$user\"}[30d]) + increase(xray_traffic_user_downlink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\", user=~\"$user\"}[30d])) / 1024 / 1024 / 1024",
          "legendFormat": "{{user}}",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "user", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "__name__": true,
              "Value #C": true
            },
            "renameByName": {
              "user": "Email",
              "alias": "Подпись",
              "Value": "Входящий трафик (B/s)",
              "Value #A": "Входящий (uplink, B/s)",
              "Value #B": "Исходящий (downlink, B/s)",
              "Value #D": "Трафик за 30д (GB)"
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              { "fieldName": "Входящий (uplink, B/s)", "config": { "id": "greater", "options": { "value": 0 } } },
              { "fieldName": "Исходящий (downlink, B/s)", "config": { "id": "greater", "options": { "value": 0 } } }
            ],
            "match": "any"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              { "field": "Трафик за 30д (GB)", "desc": true }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Входящий (uplink, B/s)" }, "properties": [ { "id": "unit", "value": "Bps" } ] },
          { "matcher": { "id": "byName", "options": "Исходящий (downlink, B/s)" }, "properties": [ { "id": "unit", "value": "Bps" } ] },
          { "matcher": { "id": "byName", "options": "Трафик за 30д (GB)" }, "properties": [ { "id": "unit", "value": "decgbytes" } ] }
        ]
      }
    },
    {
      "id": 11,
      "type": "piechart",
      "title": "Распределение трафика по протоколам inbound",
      "description": "Доля каждого inbound-протокола в общем uplink-трафике.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        { "expr": "sum by (protocol) (rate(xray_traffic_inbound_uplink_bytes_total{job=\"xray-core-metrics\", protocol=~\"$protocol\"}[10m]))", "legendFormat": "{{protocol}}", "refId": "A" }
      ],
      "options": { "displayLabels": ["name", "percent"], "legend": { "displayMode": "list", "placement": "right" } },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Доступность прокси (xray-checker)",
      "description": "Статус доступности каждого прокси по данным xray-checker (1=UP, 0=DOWN).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        {
          "expr": "max by (name, address) (xray_proxy_status{job=\"xray-checker\", instance=~\"$instance\"} or on(name, address) xray_checker_proxy_status{job=\"xray-checker\", instance=~\"$instance\"} or on(name, address) probe_success{job=\"xray-checker\", instance=~\"$instance\"})",
          "legendFormat": "{{name}} {{address}}",
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Открыть Explore",
          "url": "/explore?orgId=1&left=%7B%22datasource%22:%22VM%22,%22range%22:%7B%22from%22:%22${__from}%22,%22to%22:%22${__to}%22%7D%7D",
          "targetBlank": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Общий трафик (uplink+downlink)",
      "description": "Суммарный объём трафика (uplink + downlink) за 24 часа и за 30 дней.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        { "expr": "increase(xray_traffic_downlink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\"}[24h]) + increase(xray_traffic_uplink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\"}[24h])", "legendFormat": "За 24ч", "refId": "A" },
        { "expr": "increase(xray_traffic_downlink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\"}[30d]) + increase(xray_traffic_uplink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\"}[30d])", "legendFormat": "За 30д", "refId": "B" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Суммарный трафик пользователей (30d, GB)",
      "description": "Суммарный трафик всех пользователей (uplink + downlink) за последние 30 дней в гигабайтах.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        { "expr": "(sum(increase(xray_traffic_user_downlink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\"}[30d])) + sum(increase(xray_traffic_user_uplink_bytes_total{job=\"xray-core-metrics\", instance=~\"$instance\"}[30d]))) / 1024 / 1024 / 1024", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "decgbytes" }, "overrides": [] }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Память экспортера",
      "description": "RSS-память процесса экспортера метрик.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"xray-core-metrics\", instance=~\"$instance\"}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "CPU экспортера (cores)",
      "description": "Потребление CPU процессом экспортера (в ядрах).",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total{job=\"xray-core-metrics\", instance=~\"$instance\"}[5m])", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "cores" }, "overrides": [] }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Длительность скрейпа экспортера (сек)",
      "description": "Время, затраченное экспортером на получение и парсинг данных.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        { "expr": "xray_exporter_scrape_duration_seconds{job=\"xray-core-metrics\", instance=~\"$instance\"}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Прокси и проверка",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 104,
      "type": "row",
      "title": "Экспортёр",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 105,
      "type": "row",
      "title": "SLO и топ пользователей",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 53 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Uptime Xray Core (24ч, %)",
      "description": "SLO: процент доступности Xray Core за последние 24 часа.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        { "expr": "avg_over_time(up{job=\"xray-core-metrics\", instance=~\"$instance\"}[24h]) * 100", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Uptime Xray UI (24ч, %)",
      "description": "SLO: процент доступности Xray UI за последние 24 часа.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "VM" },
      "targets": [
        { "expr": "avg_over_time(up{job=\"xray-ui-metrics\", instance=~\"$instance\"}[24h]) * 100", "refId": "A" }
      ],
